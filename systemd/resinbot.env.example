# resinBot Slack bot configuration.
#
# install.sh copies this to /etc/resinbot/resinbot.env (root:root, mode 600).
# systemd reads it as root before dropping to the service user, so the tokens
# never need to be world-readable. Edit the installed copy, not this template:
#   sudo nano /etc/resinbot/resinbot.env
#
# Tokens come from your Slack app at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me

# Optional: where the bot reaches the printer server (default shown).
#PRINTER_SERVER_URL=http://localhost:5000
